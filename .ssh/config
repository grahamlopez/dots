# ~/.ssh/config - tracked in the dotfiles repo (dgit).
#
# Machine-local host definitions go in ~/.ssh/config.d/*.conf, which is
# NOT tracked. Keep work hostnames, jump hosts, etc. there.
#
# Include must stay ABOVE the "Host *" block: ssh takes the first value it
# obtains for most keywords, and IdentityFile accumulates in order. With the
# include first, a host-specific key is offered before the default one.

Include config.d/*.conf

Host *
    # Load the key into the agent on first use, then reuse it.
    # Change to a duration (e.g. 4h) to expire the cached passphrase.
    #
    # To force a per-connection passphrase prompt for one host, opt out in
    # its config.d block (it wins, being included above this):
    #     Host secure.example
    #         IdentityFile ~/.ssh/id_other
    #         IdentitiesOnly yes   # don't let the agent offer the key below
    #         AddKeysToAgent no    # never cache -> prompt every time
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
